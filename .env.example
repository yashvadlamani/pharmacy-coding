# Copy to .env (git-ignored) and fill in. One Azure AI Services resource serves both the LLM and OCR.
AZURE_AI_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
AZURE_AI_KEY=
AZURE_OPENAI_DEPLOYMENT=extract
# Storage account holding documents and pipeline outputs (Blob) and the catalog, codes, answers and audit trail (Table)
AZURE_STORAGE_CONNECTION_STRING=
# Workspace sign-in: a werkzeug password hash and a random string that signs the session cookie
WORKSPACE_PASSWORD_HASH=
FLASK_SECRET_KEY=
